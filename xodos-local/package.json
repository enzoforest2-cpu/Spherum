{
  "name": "xodos",
  "version": "0.1.0",
  "private": true,
  "description": "Xodós: colegas de IA que trabalham para você, rodando no seu computador.",
  "type": "module",
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "dev": "node scripts/build-ui.mjs && tsx server/main.ts",
    "test": "node scripts/build-ui.mjs && node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:windows": "node scripts/pack-windows.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@electric-sql/pglite": "^0.5.10",
    "@modelcontextprotocol/sdk": "1.32.1",
    "croner": "^10.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
