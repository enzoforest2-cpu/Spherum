# Variáveis do Spherum. Copie para .env.local (desenvolvimento) ou importe na Vercel
# (Settings → Environment Variables → cole este conteúdo no campo Key, ou "Import .env").
# Linhas sem valor ficam de fora: preencha ou apague antes de importar.
# Nunca coloque valores de verdade neste arquivo: ele vai para o Git.

# --- Obrigatórias ---------------------------------------------------------------
# Públicas (o navegador também usa).
NEXT_PUBLIC_SUPABASE_URL=https://fszbxwlxuncqefcwttru.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_zAhuSdMR3g2zHAb7WwYyCQ_XW8CLEth
APP_URL=https://spherum.com.br
# Supabase → Connect → Transaction pooler (porta 6543), com a senha do banco no lugar de [YOUR-PASSWORD].
DATABASE_URL=
# Supabase → Project Settings → API Keys → service_role (ou a secret key sb_secret_…).
SUPABASE_SERVICE_ROLE_KEY=
# 32+ caracteres aleatórios (openssl rand -base64 48). Nunca troque depois de cadastrar chaves.
XODOS_ENCRYPTION_KEY=
# Aleatório; o agendador manda em Authorization: Bearer para /api/cron/xodos.
CRON_SECRET=

# --- E-mail (convites e avisos do site) -----------------------------------------
# resend.com, com o domínio spherum.com.br verificado.
RESEND_API_KEY=
EMAIL_FROM=Spherum <nao-responda@spherum.com.br>
LEADS_NOTIFY_EMAIL=
# Opcional: sal do hash de IP do limite de envios do site.
LEADS_SALT=
# Opcional: quem recebe os chamados das agências para o suporte do Spherum (sem ele, LEADS_NOTIFY_EMAIL).
SUPPORT_NOTIFY_EMAIL=

# --- Assinatura do Spherum (as agências pagam o Spherum pelo Asaas) ------------
# Chave de API da conta Asaas do Spherum (Integrações → Chave de API; começa com $aact_).
ASAAS_SPHERUM_API_KEY=
# teste (sandbox, padrão) ou producao.
ASAAS_SPHERUM_ENV=teste
# Token do webhook: o mesmo valor vai no Asaas (Integrações → Webhooks), com a URL
# https://spherum.com.br/api/spherum/asaas e os eventos de cobrança (PAYMENT_*).
ASAAS_SPHERUM_WEBHOOK_TOKEN=

# --- Login nas plataformas (só quando for ativar cada uma) ------------------------
# Retorno a cadastrar no app de cada plataforma: https://spherum.com.br/api/integrations/<google|meta|tiktok|slack|notion|github>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Ajustes opcionais (têm padrão; só mexa se precisar) --------------------------
# META_GRAPH_VERSION=v26.0
# GOOGLE_ADS_API_VERSION=v23
# E2B_COMPUTER_TEMPLATE=desktop
# DAYTONA_COMPUTER_SNAPSHOT=
# COMPUTER_FILES_BUCKET=computer-files
# Computador pago pelo Spherum (add-on); sem elas, cada agência usa a própria chave.
# SPHERUM_E2B_API_KEY=
# SPHERUM_DAYTONA_API_KEY=

# App de celular (Web Push). Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@spherum.com.br
