# Supabase do Spherum (projeto "spherum", região São Paulo).
# A URL e a publishable key são públicas: podem ir para o navegador.
# Nunca coloque aqui a secret key (service_role) nem a senha do banco.
NEXT_PUBLIC_SUPABASE_URL=https://fszbxwlxuncqefcwttru.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_zAhuSdMR3g2zHAb7WwYyCQ_XW8CLEth

# Motor dos Xodós (só no servidor; configure na Vercel, nunca no Git).
# DATABASE_URL: conexão do pooler do Supabase em modo transação (porta 6543).
# XODOS_ENCRYPTION_KEY: 32+ caracteres (openssl rand -base64 48). Não troque depois de cadastrar chaves.
# CRON_SECRET: segredo que o agendador manda para /api/cron/xodos.
DATABASE_URL=
XODOS_ENCRYPTION_KEY=
CRON_SECRET=

# Integrações (login próprio do Spherum em cada plataforma; veja docs/INTEGRACOES.md).
